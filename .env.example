# Copy to `.env` for local development. On Render, set these in the dashboard (not in Git).

# --- Portal ---
# PORTAL_PREVIEW_MODE=False   # True = UI-only demo; False = live DB saves
# STAGING_SITE=True           # Partner QA on Render/ngrok — not yeanj.org, noindex
# PORTALS_PUBLIC=False        # Hide portal links on yeanj.org until launch-ready
# PORTAL_BOOTSTRAP_ON_DEPLOY=True
# PORTAL_ADMIN_USERNAME=yeaadmin
# PORTAL_ADMIN_PASSWORD=your-secure-password
# PORTAL_ALERT_EMAIL=you@example.com
# PORTAL_BOOTSTRAP_ON_DEPLOY=True   # Render free (no Shell): empty portal setup on deploy
# PORTAL_ADMIN_USERNAME=yeaadmin
# PORTAL_ADMIN_PASSWORD=your-secure-password-here
# PORTAL_ADMIN_NAME=YEA Admin

# --- Production (required on Render) ---
# DJANGO_SECRET_KEY=generate-a-long-random-string
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=yeanj.org,www.yeanj.org,your-app.onrender.com
# CSRF_TRUSTED_ORIGINS=https://yeanj.org,https://www.yeanj.org
# SITE_URL=https://yeanj.org
# DATABASE_URL=postgres://...  (Render sets this automatically if using render.yaml)

# --- Contact form anti-spam (optional Cloudflare Turnstile) ---
# Free at https://dash.cloudflare.com/ → Turnstile → Add site
# TURNSTILE_SITE_KEY=...
# TURNSTILE_SECRET_KEY=...

# --- Email (required on Render for applications, contact form, password reset) ---
CONTACT_EMAIL=jakeraj@yeanj.org
DEFAULT_FROM_EMAIL=jakeraj@yeanj.org
ENROLLMENT_NOTIFICATION_EMAIL=jakeraj@yeanj.org
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=jakeraj@yeanj.org
EMAIL_HOST_PASSWORD=your-google-workspace-app-password

# --- Stripe ---
# Donations (keep your existing donations Stripe account)
# STRIPE_PUBLIC_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...

# Parent portal + drop-in (your new member-payments Stripe account)
# MEMBER_STRIPE_PUBLIC_KEY=pk_live_...
# MEMBER_STRIPE_SECRET_KEY=sk_live_...
# MEMBER_STRIPE_WEBHOOK_SECRET=whsec_...  # optional, for production webhooks
